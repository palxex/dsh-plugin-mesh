{
  "name": "@palxex/dsh-plugin-mesh",
  "version": "0.5.0",
  "type": "module",
  "description": "DSH 局域网 Mesh（palxex 维护的 fork）：自动发现同网段/同 tailnet 的其他 DSH 实例，跨机双向派发任务。上游 peng456/dsh-plugin-mesh（MIT）。",
  "license": "MIT",
  "author": "peng456 (upstream)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mesh",
    "lan",
    "multicast",
    "discovery",
    "remote"
  ],
  "homepage": "https://github.com/palxex/dsh-plugin-mesh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palxex/dsh-plugin-mesh.git"
  },
  "bugs": {
    "url": "https://github.com/palxex/dsh-plugin-mesh/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node lib/_selftest-address.mjs && node lib/_selftest-portpool.mjs && node lib/_selftest-peerlink.mjs && node lib/_selftest-e2e.mjs && node lib/_selftest-proxy.mjs",
    "smoke": "node tools/host-smoke.mjs && node tools/startup-check.mjs && node tools/service-api-check.mjs && node tools/name-check.mjs",
    "selftest": "node lib/_selftest-discovery.mjs",
    "check": "node --check lib/index.js && node --check lib/discovery.js && node --check lib/scan.js && node --check lib/peerlink.js && node --check lib/directfetch.js && node --check client/client.js",
    "check:scope": "python3 tools/scopecheck.py lib/index.js",
    "check:api": "node tools/service-api-check.mjs",
    "check:name": "node tools/name-check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "contributors": [
    "palxex (https://github.com/palxex)"
  ],
  "publishConfig": {
    "access": "public"
  }
}
